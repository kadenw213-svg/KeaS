{
  "name": "keas",
  "version": "0.5.0",
  "private": true,
  "description": "KeaS: the Kea Hub (accounts, classes, study, storage and sync for Kea) and a free workforce suite for organizations.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server:dev": "node server/index.mjs --demo",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "typecheck": "tsc -p web",
    "test:server": "node --test \"test/server/*.test.mjs\"",
    "hub": "node hub/index.mjs",
    "test:hub": "node --test \"test/hub/*.test.mjs\"",
    "test:desktop": "node --test \"test/desktop/*.test.mjs\"",
    "test": "node --test \"test/server/*.test.mjs\" \"test/hub/*.test.mjs\"",
    "desktop": "electron .",
    "desktop:build": "npm run web:build && electron-builder --win nsis",
    "release": "npm run web:build && electron-builder --win nsis --publish always"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.10.2",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "zustand": "^5.0.16"
  },
  "main": "desktop/main.cjs",
  "productName": "KeaS",
  "build": {
    "appId": "com.kea.keas",
    "productName": "KeaS",
    "directories": {
      "output": "${env.LOCALAPPDATA}/KeaBuild/KeaS/release"
    },
    "files": [
      "desktop/**/*",
      "hub/**/*",
      "!hub/data/**",
      "server/**/*",
      "!server/data/**",
      "shared/**/*",
      "web/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "KeaS",
      "artifactName": "KeaS-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kadenw213-svg",
        "repo": "KeaS",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
